  // ===== FIRETV-PATCH: Fernbedienung + Zurück/Beenden ======================
  // Die Fire-TV-Fernbedienung wird hier NATIV abgefangen und an
  // firetv-dpad.js (window.__ftTv) weitergereicht. Dadurch funktioniert die
  // Steuerung auch dann, wenn die WebView nicht den Android-Fokus hat.

  private val tvScript: String by lazy {
    assets.open("firetv-dpad.js").bufferedReader().use { it.readText() }
  }
  private var tvLastExitPress = 0L

  private fun tvKeyName(keyCode: Int): String? {
    return when (keyCode) {
      android.view.KeyEvent.KEYCODE_DPAD_UP -> "up"
      android.view.KeyEvent.KEYCODE_DPAD_DOWN -> "down"
      android.view.KeyEvent.KEYCODE_DPAD_LEFT -> "left"
      android.view.KeyEvent.KEYCODE_DPAD_RIGHT -> "right"
      android.view.KeyEvent.KEYCODE_DPAD_CENTER,
      android.view.KeyEvent.KEYCODE_ENTER,
      android.view.KeyEvent.KEYCODE_NUMPAD_ENTER -> "enter"
      android.view.KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE -> "playpause"
      android.view.KeyEvent.KEYCODE_MEDIA_PLAY -> "play"
      android.view.KeyEvent.KEYCODE_MEDIA_PAUSE -> "pause"
      android.view.KeyEvent.KEYCODE_MEDIA_REWIND -> "rewind"
      android.view.KeyEvent.KEYCODE_MEDIA_FAST_FORWARD -> "forward"
      android.view.KeyEvent.KEYCODE_MENU -> "menu"
      else -> null
    }
  }

  override fun dispatchKeyEvent(event: android.view.KeyEvent): Boolean {
    val name = tvKeyName(event.keyCode) ?: return super.dispatchKeyEvent(event)
    if (event.action == android.view.KeyEvent.ACTION_DOWN) {
      if (!webView.hasFocus()) {
        webView.requestFocus()
      }
      tvSendKey(name, true)
    }
    // auch ACTION_UP verschlucken, damit die WebView nichts doppelt verarbeitet
    return true
  }

  private fun tvSendKey(name: String, retry: Boolean) {
    webView.evaluateJavascript("window.__ftTv ? window.__ftTv.key('$name') : 'missing'") { result ->
      val r = tvDecode(result)
      if (r == "missing") {
        // Skript (noch) nicht in der Seite -> einspielen und Taste wiederholen
        if (retry) {
          webView.evaluateJavascript(tvScript) { _ -> tvSendKey(name, false) }
        }
      } else if (r != null && r.startsWith("edit:")) {
        try {
          val o = org.json.JSONObject(r.substring(5))
          tvEditText(o.optString("v"), o.optString("p"), o.optString("t") == "password")
        } catch (e: Exception) {
          android.util.Log.w("FreeTubeTV", "Eingabedaten unlesbar: $r", e)
        }
      }
    }
  }

  // evaluateJavascript liefert JSON (z. B. "\"ok\"") -> in einen normalen String wandeln
  private fun tvDecode(result: String?): String? {
    if (result == null) return null
    return try {
      org.json.JSONTokener(result).nextValue() as? String
    } catch (e: Exception) {
      null
    }
  }

  // Natives Eingabefenster: hier öffnet sich die Fire-TV-Tastatur zuverlässig
  private fun tvEditText(value: String, hint: String, password: Boolean) {
    val input = android.widget.EditText(this)
    input.setText(value)
    input.setSelection(value.length)
    input.hint = hint
    input.isSingleLine = true
    input.imeOptions = android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH
    input.inputType = if (password) {
      android.text.InputType.TYPE_CLASS_TEXT or android.text.InputType.TYPE_TEXT_VARIATION_PASSWORD
    } else {
      android.text.InputType.TYPE_CLASS_TEXT
    }

    var done = false
    val dialog = android.app.AlertDialog.Builder(this)
      .setTitle(if (hint.isNotEmpty()) hint else "Eingabe")
      .setView(input)
      .setPositiveButton("Suchen / OK") { _, _ ->
        if (!done) {
          done = true
          tvApplyText(input.text.toString())
        }
      }
      .setNegativeButton("Abbrechen", null)
      .create()

    // "Fertig"/"Suchen" auf der Bildschirmtastatur übernimmt direkt
    input.setOnEditorActionListener { _, _, _ ->
      if (!done) {
        done = true
        tvApplyText(input.text.toString())
        dialog.dismiss()
      }
      true
    }

    dialog.window?.setSoftInputMode(
      android.view.WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_VISIBLE
    )
    dialog.setOnShowListener {
      input.requestFocus()
      val imm = getSystemService(android.content.Context.INPUT_METHOD_SERVICE)
        as android.view.inputmethod.InputMethodManager
      input.postDelayed({
        imm.showSoftInput(input, android.view.inputmethod.InputMethodManager.SHOW_IMPLICIT)
      }, 200)
    }
    dialog.show()
  }

  private fun tvApplyText(text: String) {
    val js = "window.__ftTv && window.__ftTv.setText(" + org.json.JSONObject.quote(text) + ", true)"
    webView.evaluateJavascript(js, null)
  }

  override fun onBack() {
    // 1. Vollbild verlassen / Textfeld verlassen (im JS)
    webView.evaluateJavascript("window.__ftTv ? window.__ftTv.back() : 'none'") { result ->
      if (result != "\"handled\"") {
        tvBackDefault()
      }
    }
  }

  private fun tvBackDefault() {
    // 2. FreeTube-Dialog schließen
    if (state.isInAPrompt) {
      webView.dispatchEvent("exit-prompt")
      webView.jsInterface.exitPromptMode()
      return
    }
    // 3. Eine Seite zurück; wenn sich nichts tut, sind wir auf der Startseite
    val before = webView.url
    if (webView.canGoBack()) {
      webView.goBack()
      webView.postDelayed({
        if (webView.url == before) {
          tvAskExit()
        }
      }, 400)
    } else {
      tvAskExit()
    }
  }

  private fun tvAskExit() {
    // 4. Auf der Startseite: 2x Zurück innerhalb von 2,5 s = App beenden
    val now = android.os.SystemClock.uptimeMillis()
    if (now - tvLastExitPress < 2500) {
      finishAndRemoveTask()
    } else {
      tvLastExitPress = now
      android.widget.Toast.makeText(
        this, "Zum Beenden nochmal Zurück drücken", android.widget.Toast.LENGTH_SHORT
      ).show()
    }
  }
  // ===== /FIRETV-PATCH ======================================================
